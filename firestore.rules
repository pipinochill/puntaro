rules_version = '2';
// Puntaro.
//   users/{uid}/...                     your account: profile, round in progress, finished rounds. Yours alone.
//   refs/{code}, refs/{code}/joins/{uid} invite codes, and the new players who signed up from each one
//   profiles/{uid}                      the card your friends see (name, handicap, stats)
//   friends/{uid}/list/{uid}, requests/{to}/in/{from}  friendships and friend requests
//   rounds/{PUNT-XXXXX}                 a live round, shared by the players in it
//   rounds/{PUNT-XXXXX}/banks/{pid_h}   one secret bank call per player per hole
// Bank calls stay secret until every joined player has moved past that hole (at[pid] > h),
// and a player's own call locks the moment they move on.
// A finished live round (done) is read-only for everyone and is never deleted.
service cloud.firestore {
  match /databases/{database}/documents {

    // Your account. Nobody else can read or change it. Who invited you (referredBy) is set once, at sign-up.
    match /users/{uid} {
      allow read, create, delete: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.get('referredBy', null) == resource.data.get('referredBy', null);
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Invite codes. Anyone signed in can look one up (to show "Invited by Pierre"). Codes are never reused or changed.
    match /refs/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null && code.matches('[a-z]{1,10}-[a-z0-9]{4}')
        && request.resource.data.keys().hasOnly(['owner', 'name', 'createdAt'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 30
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
      // A new player adds themselves, once, to the code named in their own account. Never your own code.
      // Only the code's owner can see who joined.
      match /joins/{uid} {
        function ref() { return get(/databases/$(database)/documents/refs/$(code)).data; }
        allow get, list: if request.auth != null && ref().owner == request.auth.uid;
        allow create: if request.auth != null && uid == request.auth.uid
          && ref().owner != request.auth.uid
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('referredBy', '') == code
          && request.resource.data.keys().hasOnly(['name', 'at'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 30
          && request.resource.data.at == request.time;
        allow update, delete: if false;
      }
    }

    // ---- Friends ----
    function authed() { return request.auth != null; }
    function areFriends(a, b) { return exists(/databases/$(database)/documents/friends/$(a)/list/$(b)); }
    function asked(to, from) { return exists(/databases/$(database)/documents/requests/$(to)/in/$(from)); }
    // `me` signed up from `owner`'s invite code (the code named in the friendship).
    function invitedBy(me, owner, code) {
      return code is string && code.matches('[a-z]{1,10}-[a-z0-9]{4}')
        && exists(/databases/$(database)/documents/refs/$(code))
        && get(/databases/$(database)/documents/refs/$(code)).data.owner == owner
        && get(/databases/$(database)/documents/users/$(me)).data.get('referredBy', '') == code;
    }

    // The card your friends see. Only you write it; you, your friends and anyone you've sent a request to can read it.
    match /profiles/{uid} {
      allow read: if authed() && (request.auth.uid == uid || areFriends(uid, request.auth.uid) || asked(request.auth.uid, uid));
      allow create, update: if authed() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'first', 'li', 'color', 'hi', 'hk', 'ref', 'stats', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 30
        && request.resource.data.updatedAt == request.time;
      allow delete: if authed() && request.auth.uid == uid;
    }

    // A friend request from `from` to `to`. Either of them can see it or take it back; nobody can change it.
    match /requests/{to}/in/{from} {
      allow read: if authed() && (request.auth.uid == to || request.auth.uid == from);
      allow create: if authed() && request.auth.uid == from && from != to && !areFriends(to, from)
        && request.resource.data.keys().hasOnly(['name', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 30
        && request.resource.data.at == request.time;
      allow delete: if authed() && (request.auth.uid == to || request.auth.uid == from);
      allow update: if false;
    }

    // Alpha feedback. Write-only from the app: read them in the Firebase console.
    match /feedback/{id} {
      allow create: if authed() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'text', 'name', 'version', 'device', 'at'])
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
        && request.resource.data.at == request.time;
      allow read, update, delete: if false;
    }

    // Friendships live in both people's lists. You can add one only by accepting their request,
    // or because you signed up from their invite. Either of you can end it.
    match /friends/{uid}/list/{fid} {
      allow read: if authed() && request.auth.uid == uid;
      allow create: if authed() && uid != fid
        && request.resource.data.keys().hasOnly(['since', 'via'])
        && request.resource.data.since == request.time && request.resource.data.via is string
        && ((request.auth.uid == uid && (asked(uid, fid) || areFriends(fid, uid) || invitedBy(uid, fid, request.resource.data.via)))
          || (request.auth.uid == fid && (asked(fid, uid) || invitedBy(fid, uid, request.resource.data.via))));
      allow delete: if authed() && (request.auth.uid == uid || request.auth.uid == fid);
      allow update: if false;
    }

    // Revealed = the round is finished, or every joined (claimed) player has moved past hole h. Up to 8 players.
    function movedOn(r, i, h) {
      return r.base.playerIds.size() <= i
        || r.claims.get(r.base.playerIds[i], null) == null
        || r.get('at', {}).get(r.base.playerIds[i], 0) > h;
    }
    function revealed(r, h) {
      return r.get('done', false) == true || movedOn(r, 0, h) && movedOn(r, 1, h) && movedOn(r, 2, h) && movedOn(r, 3, h)
        && movedOn(r, 4, h) && movedOn(r, 5, h) && movedOn(r, 6, h) && movedOn(r, 7, h);
    }

    match /rounds/{code} {
      function signedIn() { return request.auth != null; }
      function before() { return resource.data; }
      function after() { return request.resource.data; }
      function me() { return request.auth.uid; }
      function isHost() { return before().host == me(); }
      function isMember() { return before().get('members', {}).get(me(), false) == true; }
      function changed() { return after().diff(before()).affectedKeys(); }
      function touches(k) { return k in changed(); }

      // Nobody can change the host, the code, the setup or the player list. The clock is the server's.
      function keepsSetup() {
        return after().host == before().host && after().code == before().code
          && after().base == before().base && after().people == before().people
          && after().updatedAt == request.time;
      }
      // hostAt: when the host's phone last wrote to the round. Only the host's writes move it.
      function hostClock() {
        return isHost() ? after().hostAt == request.time : after().hostAt == before().hostAt;
      }
      // Finishing: the host, or any player once the host's phone has been silent for 6 hours (say it died).
      function finishes() {
        return changed().hasOnly(['done', 'doneBy', 'updatedAt', 'hostAt']) && after().done == true && after().doneBy == me()
          && (isHost() || (isMember() && request.time > before().hostAt + duration.value(6, 'h')));
      }
      function joinKeys() { return ['members', 'claims', 'who', 'updatedAt']; }
      function watchKeys() { return ['members', 'claims', 'at', 'who', 'updatedAt']; }
      function playKeys() { return ['s', 'ev', 'ntp', 'wolf', 'bbb', 'draws', 'deal', 'by', 'ed', 'members', 'claims', 'at', 'who', 'updatedAt']; }
      function hostKeys() { return ['s', 'ev', 'ntp', 'wolf', 'bbb', 'draws', 'deal', 'by', 'ed', 'members', 'claims', 'at', 'who', 'updatedAt', 'hostAt', 'bk', 'scoring']; }

      // Only ever add yourself to members.
      function joinsSelf() {
        return after().members.diff(before().get('members', {})).affectedKeys().hasOnly([me()])
          && after().members[me()] == true;
      }
      // Take one free seat (the one named in `who`), and only if you don't hold a seat already.
      function takesSeat() {
        let d = after().claims.diff(before().claims);
        return d.affectedKeys().hasOnly([after().who]) && d.addedKeys().hasOnly([after().who])
          && after().who in before().base.playerIds
          && after().claims[after().who] == me()
          && !(me() in before().claims.values());
      }
      // The host can free up a seat (a dead phone) so the round isn't stuck waiting.
      function releasesSeat() {
        let d = after().claims.diff(before().claims);
        return isHost() && d.affectedKeys().size() == 1 && d.removedKeys().size() == 1;
      }
      // Move your own player forward. Never backwards, never someone else.
      function movesOn() {
        let d = after().at.diff(before().get('at', {}));
        let w = after().who;
        return d.affectedKeys().hasOnly([w]) && before().claims.get(w, null) == me()
          && after().at[w] is int && after().at[w] > before().get('at', {}).get(w, 0) && after().at[w] <= 18;
      }
      // "edited" marks can be added but never removed.
      function keepsEdits() { return after().get('ed', {}).keys().hasAll(before().get('ed', {}).keys()); }
      // Cards: one card hole at a time (named in `deal`), never changed once dealt, and in
      // "everyone scores" only after the previous hole's bank calls are revealed.
      // Phones also re-check every deal against the shared shuffle and ignore any that don't match.
      function addsDraws() {
        let d = after().draws.diff(before().get('draws', {}));
        return d.changedKeys().size() == 0 && d.removedKeys().size() == 0
          && after().deal is int && d.addedKeys().hasOnly([string(after().deal)])
          && (before().scoring != 'each' || revealed(before(), after().deal - 1));
      }

      allow get: if signedIn();
      allow list: if false; // no browsing other people's rounds
      allow create: if signedIn()
        && code.matches('PUNT-[A-Z0-9]{5}')
        && after().updatedAt == request.time && after().hostAt == request.time
        && after().get('done', false) == false
        && after().code == code
        && after().host == me()
        && after().scoring in ['each', 'one']
        && after().claims == {'me': me()}
        && after().members.keys().hasOnly([me()]) && after().members[me()] == true
        && after().get('at', {}).size() == 0;
      allow update: if signedIn() && keepsSetup() && hostClock() && before().get('done', false) == false && (finishes() || (
        !touches('done') && !touches('doneBy')
        && (isMember() || changed().hasOnly(joinKeys()))
        && (isHost() ? changed().hasOnly(hostKeys())
            : before().scoring == 'each' ? changed().hasOnly(playKeys())
            : changed().hasOnly(watchKeys()))
        && (!touches('members') || joinsSelf())
        && (!touches('claims') || takesSeat() || releasesSeat())
        && (!touches('at') || movesOn())
        && (!touches('ed') || keepsEdits())
        && (!touches('draws') || addsDraws())
        && (!touches('bk') || (before().scoring == 'one' && after().scoring == 'one'))
        && (!touches('scoring') || after().scoring in ['each', 'one'])));
      allow delete: if false; // finished rounds belong to everyone who played

      match /banks/{key} {
        function round() { return get(/databases/$(database)/documents/rounds/$(code)).data; }
        function pid() { return key.split('_')[0]; }
        function hole() { return int(key.split('_')[1]); }

        // Your own call, or anyone's once the hole is revealed.
        allow get: if signedIn() && (revealed(round(), hole()) || (resource != null && resource.data.uid == request.auth.uid));
        allow list: if false;
        allow create, update: if signedIn()
          && request.resource.data.keys().hasOnly(['pid', 'h', 'v', 'uid'])
          && request.resource.data.pid == pid() && request.resource.data.h == hole()
          && hole() >= 0 && hole() < 18
          && request.resource.data.v is bool
          && request.resource.data.uid == request.auth.uid
          && round().scoring == 'each'
          && round().get('done', false) == false
          && pid() in round().base.playerIds
          && round().get('members', {}).get(request.auth.uid, false) == true
          && (round().claims.get(pid(), null) == request.auth.uid
                ? round().get('at', {}).get(pid(), 0) <= hole()            // your call, until you move on
                : (round().claims.get(pid(), null) == null && !revealed(round(), hole()))); // a player with no phone
        allow delete: if false;
      }
    }
  }
}
